!bash setup.sh

# %% [code]
# ╔══════════════════════════════════════════════════════════════╗
# ║  Cell 2: Verify CUDA                                        ║
# ╚══════════════════════════════════════════════════════════════╝
import torch
print(f"PyTorch {torch.__version__}")
print(f"CUDA available: {torch.cuda.is_available()}")
if torch.cuda.is_available():
    print(f"GPU: {torch.cuda.get_device_name(0)}")
    vram = torch.cuda.get_device_properties(0).total_memory / 1e9
    print(f"VRAM: {vram:.1f} GB")
    assert vram > 14, "Need T4 (15GB) or better"

# %% [code]
# ╔══════════════════════════════════════════════════════════════╗
# ║  Cell 3: Import + smoke test                                ║
# ╚══════════════════════════════════════════════════════════════╝
import sys; sys.path.insert(0, "src")

from kda_moe.compat import apply_triton_patch
apply_triton_patch()

from kda_moe.config import ModelConfig
from kda_moe.model import KDAMoEModel

# Quick smoke — does the model build and do one forward pass?
config = ModelConfig.preset_1b()
config.seq_len = 64
model = KDAMoEModel(config).cuda()
total, _ = model.get_num_params()
print(f"Model: {total/1e6:.1f}M params")
input_ids = torch.randint(0, config.vocab_size, (1, 64), device="cuda")
with torch.autocast("cuda", torch.bfloat16):
    logits = model(input_ids)
print(f"Forward OK — output shape: {logits.shape}")
del model; torch.cuda.empty_cache()

