# ║  Cell 7: Quick eval — generate from smoke prompts           ║
# ╚══════════════════════════════════════════════════════════════╝
import torch
from kda_moe.config import ModelConfig
from kda_moe.model import KDAMoEModel
from kda_moe.tokenizer import load_tokenizer
from kda_moe.eval import generate
from kda_moe.train import load_checkpoint

config = ModelConfig.preset_1b()
model = KDAMoEModel(config).cuda()
load_checkpoint(model, None, "artifacts/checkpoints_1b/step_10000.pt", device="cuda")
tokenizer = load_tokenizer("artifacts/tokenizer/tokenizer.json")

prompts = [
    "The capital of France is",
    "def fibonacci(n):",
    "<|system|>You are a coding agent.<|user|>Read src/main.py<|assistant|>",
]
for p in prompts:
    out = generate(model, tokenizer, p, max_new_tokens=64, temperature=0.8)
    print(f"\n>>> {p}")
    print(f"    {out}")
